# Hand-maintained mediamtx overrides. mediamtx loads these AFTER mediamtx.yml (a verbatim copy of
# upstream mediamtx's v1.21.2 file), so mediamtx.yml can be replaced wholesale on a version bump.
# Env vars are read at startup only: changes need `docker compose up -d`.
# Per-printer paths are NOT here - build-printers-env.sh generates them into printers.env.

# WebRTC: fixed TCP port (docker port mapping), no container IPs, advertise the host's LAN IP
MTX_WEBRTCLOCALTCPADDRESS=:8189
MTX_WEBRTCIPSFROMINTERFACES=no
MTX_WEBRTCADDITIONALHOSTS=FIXME_this_is_my_docker_host_ip

# HLS as the app's /_hlsstream/ player expects it (same as the old mediamtx.yml)
MTX_HLSALWAYSREMUX=yes
MTX_HLSVARIANT=mpegts

# Pull printers over TCP: UDP has no read timeout, so a stalled printer would go unnoticed
MTX_PATHDEFAULTS_RTSPTRANSPORT=tcp
